@page "/adminpage"
@using BlazorApp.ApiRequest
@using BlazorApp.ApiRequest.Model
@inject CurrentUser CurrentUser
@inject NavigationManager Nav

@if (!CurrentUser.IsLoggedIn)
{ 
    Nav.NavigateTo("/register");
    return;
}

<main>
    <div class="user-global-block container">
        <div class="user-avatar" style="cursor: pointer;">
            <label>
                <img src="@AvatarUrl" alt="avatar" class="main-avatar" />
                <InputFile OnChange="HandleFileUpload" accept="image/*" style="display: none;" />
            </label>
        </div>
        <div class="profile-card">
            <div class="info-row">
                <span class="label">Имя:</span>
                <span class="value">@CurrentUser.CurrentName</span>
            </div>

            <div class="info-row">
                <span class="label">Почта:</span>
                <span class="value">@CurrentUser.CurrentMail</span>
            </div>

            <div class="info-row">
                <span class="label">Пароль:</span>
                <span class="value">********</span>
            </div>

            <button class="btn-edit" @onclick="OpenEditModal">Редактировать</button>
        </div>
    </div>
    <div class="admin-actions">
        <button class="btn-admin" @onclick="GoToUsers">👥 Все пользователи</button>
    </div>
</main>

@if (updateUser != null)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h3>Редактирование профиля</h3>
            
            <label>Имя:</label>
            <input type="text" @bind="updateUser.UserName" />
            
            <label>Почта:</label>
            <input type="text" @bind="updateUser.Mail" />
            
            <label>Новый пароль:</label>
            <input type="text" @bind="updateUser.Password"/>
            
            <div class="modal-actions">
                <button class="btn-edit" @onclick="SaveChanges">Сохранить</button>
                <button class="btn-delete" @onclick="CloseModal">Отмена</button>
            </div>
        </div>
    </div>
}

@code {
    private string AvatarUrl;
    private UserDataShort? currentUser;
    private UserDataShort? updateUser;
    
    [Inject] private RequestApi _apiRequest { get; set; }
    [Inject] private CurrentUser _session { get; set; }

    protected override void OnInitialized()
    {
        if (_session.IsLoggedIn)
        {
            currentUser = new UserDataShort
            {
                UserId = _session.CurrentID,
                UserName = _session.CurrentName,
                Mail = _session.CurrentMail,
                Password = _session.CurrentPassword,
                AvatarUrl = _session.CurrentAvatar,
                RoleName = _session.CurrentRole
            };
            if (string.IsNullOrEmpty(_session.CurrentAvatar))
            {
                AvatarUrl = "https://img.freepik.com/free-psd/contact-icon-illustration-isolated_23-2151903337.jpg?semt=ais_hybrid&w=740&q=80";
            }
            else
            {
                AvatarUrl = _session.CurrentAvatar;
            }
        }
    }

    private void OpenEditModal()
    {
        if (currentUser != null)
        {
            updateUser = new UserDataShort
            {
                UserId = currentUser.UserId,
                UserName = currentUser.UserName,
                Mail = currentUser.Mail,
                Password = currentUser.Password
            };
        }
    }
    
    private void CloseModal()
    {
        updateUser = null;
    }

    private async Task SaveChanges()
    {
        if (updateUser != null)
        {
            var result = await _apiRequest.PatchUserAsync(updateUser);
            
            if (result.status)
            {
                currentUser = updateUser; 
                _session.CurrentName = updateUser.UserName;
                _session.CurrentMail = updateUser.Mail;
                _session.CurrentPassword = updateUser.Password;
                
                CloseModal();
            }
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            if (!file.ContentType.StartsWith("image/")) return;
            
            long maxBytes = 5 * 1024 * 1024;
            using var stream = file.OpenReadStream(maxAllowedSize: maxBytes);
            
            var result = await _apiRequest.UploadAvatarAsync(stream, file.Name, CurrentUser.CurrentID);
            
            if (result.status && !string.IsNullOrEmpty(result.AvatarUrl))
            {
                AvatarUrl = result.AvatarUrl;
                if (currentUser != null) currentUser.AvatarUrl = AvatarUrl;
                _session.CurrentAvatar = AvatarUrl;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
    }
    private void GoToUsers()
    {
        Nav.NavigateTo("/AdminPanel");
    }
}