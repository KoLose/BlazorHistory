@page "/counter"
@using BlazorApp.ApiRequest
@using BlazorApp.ApiRequest.Model

<PageTitle>MovieTable</PageTitle>
<table class="table">
    <thead>
    <tr>
        <th>id</th>
        <th>Name</th>
        <th>ImageUrl</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var image in images)
    {
        <tr>
            <td>@image.Id</td>
            <td>@image.Name</td>
            <td>@image.ImageUrl</td>
            <td><a href="#">Edit</a></td>
            <td><a href="#">Delete</a></td>
        </tr>
    }
    </tbody>
</table>

@code {
    private List<ImageDataShort> images = new();
    [Inject] private RequestApi _apiRequest { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await GetAllImages();
    }

    private async Task GetAllImages()
    {
        var imageData = await _apiRequest.GetAllImagesAsync();
        //users = userData.data.users ?? new List<UserDataShort>();
        images = imageData?.data?.image ?? new List<ImageDataShort>();
    }
}