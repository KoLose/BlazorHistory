@page "/counter"
@using BlazorApp.ApiRequest
@using BlazorApp.ApiRequest.Model

<PageTitle>Список документов</PageTitle>

<div class="cards">
    @foreach (var image in images)
    {
        <div class="card">
            <img src="@image.ImageUrl" alt="Document" />
            
            @if (!string.IsNullOrEmpty(image.ExcelUrl))
            {
                <p><a href="@image.ExcelUrl" target="_blank">📥 Скачать Excel</a></p>
            }
            else
            {
                <p>Обработка...</p>
            }
        </div>
    }
</div>

@code {
    private List<ImageDataShort> images = new();
    [Inject] private RequestApi _apiRequest { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await GetAllImages();
    }

    private async Task GetAllImages()
    {
        var imageData = await _apiRequest.GetAllImagesAsync();
        images = imageData?.data?.image ?? new List<ImageDataShort>();
    }
}